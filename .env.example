PORT=3000
DATABASE_PATH=./data/reminders.db
TZ=Asia/Kolkata

# Telegram Bot API (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id (numeric). Message the bot, then check logs, or use @userinfobot
ALLOWED_TELEGRAM_CHAT_ID=

# Bootstrap times for visa digests until you Save schedule on /visa.html
# After saving in the UI, weekdays + times live in SQLite instead.
VISA_DIGEST_TIMES=09:00

# Optional: also email visa digests (same body as Telegram)
VISA_DIGEST_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset
SMTP_FROM=
